---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import swoosh from '../assets/home/Group-39473.png';
import { faqEntries, type FaqEntry } from '../data/home-faq';

/**
 * Shared by Home, /features/ and /docs/. Home and /features/ carry the same
 * five questions and the same subtitle, so those stay the defaults; /docs/
 * passes its own set.
 *
 * `name` groups the <details> into a native exclusive accordion, so it has to
 * be unique per page — two blocks sharing a name would close each other.
 */
export interface Props {
  entries?: FaqEntry[];
  sub?: string;
  name?: string;
}
const {
  entries = faqEntries,
  sub = 'Still Need Help? Reach out to our dedicated support team anytime',
  name = 'home-faq',
} = Astro.props;

/* Font Awesome 6 Free "angle-down" (solid), viewBox 448x512 — the original
 * swaps this glyph for "angle-up" when a panel opens; a 180deg rotation gets
 * to the same shape from one path. Icon: Font Awesome Free 6, CC BY 4.0. */
const ANGLE_DOWN =
  'M201.4 342.6c12.5 12.5 32.8 12.5 45.3 0l160-160c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 274.7 86.6 137.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l160 160z';
---
<section class="faq">
  <Container class="faq__card">
    <div class="faq__row">
      <div class="faq__intro">
        <div class="faq__lead">
          <h2 class="faq__title" data-anim="heading">Frequently Asked Questions</h2>
          <p class="faq__sub" data-anim="text">{sub}</p>
        </div>
        <div class="faq__swoosh" data-anim="chip">
          <Image src={swoosh} alt="" width={58} height={54} loading="lazy" />
        </div>
      </div>

      <div class="faq__list">
        {entries.map((entry, i) => (
          <details class="faq__item" data-anim="card" name={name} open={i === 0}>
            <summary class="faq__q">
              <span class="faq__icon">
                <svg viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path d={ANGLE_DOWN} /></svg>
              </span>
              <span class="faq__q-text"><h3 class="faq__q-title">{entry.q}</h3></span>
            </summary>
            <div class="faq__a"><p>{entry.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </Container>
</section>
