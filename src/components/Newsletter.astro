---
/**
 * Newsletter band. Measured: brand-mid (#6AA63C) card, 24px radius,
 * 80/20/56 padding, heading 24/30/48px by breakpoint, 467x58 white form
 * with a 12px radius and a 113x46 Subscribe button.
 *
 * Posts to /api/subscribe, which forwards to FluentCRM (A1 decision).
 * The original rendered this form 2-3x per page with duplicate ids
 * (§B7 item 10); it appears once here.
 */
import Container from './Container.astro';
---
<section class="newsletter">
  <Container class="newsletter__card">
    <h2 class="newsletter__heading">Get Shopify Tips &amp; Latest Updates</h2>
    <p class="newsletter__sub">
      Be the first to know about our latest news, offers, and Shopify Tips
    </p>

    <form class="newsletter__form" method="post" action="/api/subscribe" data-newsletter>
      <label class="sr-only" for="newsletter-email">Your Email Address</label>
      <input
        class="newsletter__input"
        id="newsletter-email"
        type="email"
        name="email"
        placeholder="Your Email Address"
        autocomplete="email"
        required
      />
      <button class="newsletter__submit" type="submit">Subscribe</button>
    </form>
    <p class="newsletter__status" data-newsletter-status role="status" aria-live="polite"></p>
  </Container>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const status = document.querySelector<HTMLElement>('[data-newsletter-status]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button');
    const email = new FormData(form).get('email');
    if (btn) btn.disabled = true;
    if (status) status.textContent = '';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json().catch(() => ({}));
      if (status) {
        status.textContent = res.ok
          ? (data.message ?? 'Thanks — please check your inbox to confirm.')
          : (data.message ?? 'Something went wrong. Please try again.');
        status.dataset.state = res.ok ? 'ok' : 'error';
      }
      if (res.ok) form.reset();
    } catch {
      if (status) {
        status.textContent = 'Network error. Please try again.';
        status.dataset.state = 'error';
      }
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
