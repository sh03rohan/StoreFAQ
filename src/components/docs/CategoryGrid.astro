---
import { Image } from 'astro:assets';
import Container from '../Container.astro';
import { routes } from '../../lib/routes';
import { getDocsCategories } from '../../data/docs-categories';
const docsCategories = await getDocsCategories();
---
<section class="docs-cats">
  <Container>
    <div class="docs-cats__card">
      <div class="docs-cats__grid">
        {docsCategories.map((c) => (
          <a class="docs-cat" data-anim="card" href={routes.docCategory(c.slug)}>
            <span class="docs-cat__icon">
              <Image src={c.icon} alt="" width={32} height={32} loading="lazy" />
            </span>
            <h2 class="docs-cat__title">{c.title}</h2>
            <span class="docs-cat__count">{c.count} Docs</span>
            <span class="docs-cat__updated">Last Updated: {c.updated}</span>
          </a>
        ))}
      </div>
    </div>
  </Container>
</section>
