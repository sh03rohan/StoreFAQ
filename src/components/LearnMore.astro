---
import { routes } from '../lib/routes';

/* Font Awesome 6 Free "arrow-right-long" (solid), viewBox 512x512.
 * Icon: Font Awesome Free 6, CC BY 4.0. */
const ARROW =
  'M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-128-128c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-73.4 73.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l128-128z';

export interface Props {
  /** Docs article slug the link resolves to. */
  slug: string;
}
const { slug } = Astro.props;
---
<a class="learn-more" href={routes.doc(slug)}>
  Learn More
  <svg viewBox="0 0 512 512" aria-hidden="true" focusable="false"><path d={ARROW} /></svg>
</a>
