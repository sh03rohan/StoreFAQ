---
import Container from '../Container.astro';
import { plans, pricingRows } from '../../data/home-pricing';
import { go } from '../../lib/routes';

/* The original uses Font Awesome's *regular* (outlined) circle glyphs. */

/* Grid rows: 1 = "Popular" badge band, 2 = plan header, 3.. = features.
 * At 1280+ the columns become `display: contents` so every cell is a direct
 * grid child, which lets the browser equalise row heights the way the
 * original does with JavaScript. */
const HEADER_ROW = 2;
---
<section class="pricing">
  <Container>
    <h2 class="pricing__heading">Choose The Plan That Best Fits Your Store’s Requirements</h2>

    <div class="pricing__table">
      <!-- Draws the table's border/radius from the header row down, so the
           "Popular" badge sits outside the shell as it does on the original. -->
      <div class="pricing__frame" aria-hidden="true"></div>
      <!-- Label column: shown only at 1280+. Below that each plan card
           repeats its own labels, as on the original. -->
      <div class="pricing__labels">
        <div class="pricing__cell pricing__cell--header" style={`--row:${HEADER_ROW}`}></div>
        {pricingRows.map((r, i) => (
          <div class="pricing__cell pricing__cell--label" style={`--row:${HEADER_ROW + 1 + i};--row-h:${r.height}px;--row-h-md:${r.heightMd}px`}>
            <span
              class:list={['pricing__label', (r.accent || r.gradient) && 'has-sparkle', r.tip && 'has-tip']}
              title={r.tip}
            ><span class:list={[r.accent && 'is-accent', r.gradient && 'is-gradient']}>{r.label}</span></span>
          </div>
        ))}
      </div>

      {plans.map((plan, pi) => (
        <div class:list={['pricing__plan', plan.popular && 'is-popular']} style={`--col:${pi + 2}`}>
          {plan.popular && (
            <p class="pricing__badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z" />
              </svg>
              Popular
            </p>
          )}

          <div class="pricing__cell pricing__cell--header" style={`--row:${HEADER_ROW}`}>
            <h3 class="pricing__plan-name">{plan.name}</h3>
            <p class="pricing__price">
              <span class="pricing__currency">{plan.currency}</span>{plan.price}<span class="pricing__period">{plan.period}</span>
            </p>
            {plan.yearly && <p class="pricing__yearly">{plan.yearly}</p>}
            <a class="pricing__cta" href={go.getStarted()}>Get Started</a>
          </div>

          {pricingRows.map((r, i) => {
            const cell = r.cells[pi]!;
            return (
              <div class="pricing__cell" style={`--row:${HEADER_ROW + 1 + i};--row-h:${r.height}px;--row-h-md:${r.heightMd}px`}>
                <span
                  class:list={['pricing__cell-label', (r.accent || r.gradient) && 'has-sparkle', r.tip && 'has-tip']}
                ><span class:list={[r.accent && 'is-accent', r.gradient && 'is-gradient']}>{r.label}</span></span>
                <span class:list={['pricing__value', cell.tip && 'has-tip']}>
                  {cell.icon ? (
                    <>
                      <svg class:list={['pricing__icon', cell.icon === 'x' && 'is-x']} width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
                        {cell.icon === 'x'
                          ? <path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                          : <path d="M7.8 12.4l2.7 2.7 5.7-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />}
                      </svg>
                      <span class="sr-only">{cell.icon === 'x' ? 'Not included' : 'Included'}</span>
                    </>
                  ) : cell.text}
                </span>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </Container>
</section>
