---
import { Image } from 'astro:assets';
import Container from '../Container.astro';
import swoosh from '../../assets/home/Group-39473.png';
import cta from '../../assets/home/cta.jpg';
import { external } from '../../lib/routes';
---
<section class="cta">
  <Container class="cta__card">
    <div class="cta__text">
      <h2 class="cta__title" data-anim="heading">Ready To Build Stunning FAQs?&nbsp;Get Started With StoreFAQ Today!</h2>
      <Image class="cta__swoosh" data-anim="chip" src={swoosh} alt="" width={58} height={54} loading="lazy" />
      <a class="cta__link" data-anim="chip" href={external.shopifyApp} target="_blank" rel="noopener noreferrer">
        Try StoreFAQ Today
      </a>
    </div>
    <div class="cta__media" data-anim="media">
      <Image
        src={cta}
        alt="StoreFAQ FAQ page shown on a laptop and a phone"
        widths={[600, 1042]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="lazy"
      />
    </div>
  </Container>
</section>
