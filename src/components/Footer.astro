---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Newsletter from './Newsletter.astro';
import logo from '../assets/footer-logo.png';
import startise from '../assets/startisewhite.png';
import xcloud from '../assets/xcloudwhite.png';
import { footerColumns, socialLinks } from '../data/nav';
import { routes } from '../lib/routes';

const year = new Date().getFullYear();

const icons = {
  facebook: 'M9.1 20v-7.1H6.6V9.9h2.5V7.7c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6v1.8h2.8l-.4 3H12.2V20',
  linkedin: 'M6.9 20H3.9V9.5h3V20zM5.4 8.2A1.8 1.8 0 115.4 4.6a1.8 1.8 0 010 3.6zM20 20h-3V14.9c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V20h-3V9.5h2.9v1.4h.1a3.2 3.2 0 012.9-1.6c3.1 0 3.7 2 3.7 4.7V20z',
};
---
<Newsletter />

<footer class="footer">
  <Container width="content" class="footer__cols">
    <div class="footer__brand">
      <a href={routes.home()} aria-label="StoreFAQ home">
        <Image src={logo} alt="StoreFAQ" widths={[95, 190, 286]} sizes="95px" loading="lazy" />
      </a>
    </div>

    {footerColumns.map((col) => (
      <nav class="footer__col" aria-label={col.heading}>
        <h2 class="footer__heading">{col.heading}</h2>
        <ul class="footer__list">
          {col.items.map((item) => (
            <li>
              <a
                class="footer__link"
                href={item.href}
                {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}

    <div class="footer__col">
      <h2 class="footer__heading">Community</h2>
      <ul class="footer__social">
        {socialLinks.map((s) => (
          <li>
            <a class="footer__social-link" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={icons[s.icon]} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>

  <Container class="footer__bar">
    <p class="footer__copy">
      Copyright &copy; {year} | A Storeware Product from
      <a class="footer__copy-link" href="https://storeware.io/" target="_blank" rel="noopener noreferrer">Storeware</a>
      <a href="https://startise.com/" target="_blank" rel="noopener noreferrer" aria-label="Startise">
        <Image class="footer__partner" src={startise} alt="Startise" widths={[70, 140]} sizes="70px" loading="lazy" />
      </a>
      family
    </p>
    <p class="footer__hosted">
      Hosted with
      <a href="https://xcloud.host/" target="_blank" rel="noopener noreferrer" aria-label="xCloud">
        <Image class="footer__partner" src={xcloud} alt="xCloud" widths={[51, 102]} sizes="51px" loading="lazy" />
      </a>
    </p>
  </Container>
</footer>
