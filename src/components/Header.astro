---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import logo from '../assets/header-logo.png';
import badge from '../assets/built-for-shopify.png';
import { primaryNav, headerCta } from '../data/nav';
import { routes } from '../lib/routes';

const path = Astro.url.pathname;
/* The item for the SECTION the page is in, not only the page itself: a post
 * lights "Blog", a doc or a docs category lights "Documentation", and a
 * parent lights when one of its children is current. Home is exact. */
const inSection = (href: string) => {
  if (href === path) return true;
  if (href === routes.home() || /^https?:/.test(href)) return false;
  if (href === routes.blog()) return path.startsWith('/blog/') || path.startsWith('/category/');
  if (href === routes.docs()) return path.startsWith('/docs/') || path.startsWith('/docs-category/');
  return path.startsWith(href);
};
const isCurrent = (href: string, children?: { href: string }[]) =>
  inSection(href) || (children ?? []).some((c) => inSection(c.href));
---
<header class="header">
  <Container class="header__row">
    <div class="header__brand">
      <a class="header__logo" href={routes.home()} aria-label="StoreFAQ home">
        <Image src={logo} alt="StoreFAQ" widths={[120, 240, 357]} sizes="120px" loading="eager" />
      </a>
      <!-- Badge is a bitmap on the original; kept as-is for fidelity.
           Flagged in NOTES.md as an image of text. -->
      <Image class="header__badge" src={badge} alt="Built for Shopify" widths={[120, 240]} sizes="120px" loading="eager" />
    </div>

    <!-- Hamburger: shown at =<599px (reference/CHROME.json) -->
    <button
      class="header__burger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="primary-menu"
      data-menu-open
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>

    <nav class="header__nav" id="primary-menu" aria-label="Primary">
      <button
        class="header__close"
        type="button"
        aria-label="Close menu"
        data-menu-close
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>

      <ul class="header__list">
        {primaryNav.map((item) => (
          <li class:list={['header__item', item.children && 'header__item--has-child']}>
            <a
              class="header__link"
              href={item.href}
              aria-current={isCurrent(item.href, item.children) ? 'page' : undefined}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >{item.label}</a>

            {item.children && (
              <>
                <button
                  class="header__submenu-toggle"
                  type="button"
                  aria-label={`${item.label} submenu`}
                  aria-expanded="false"
                  data-submenu-toggle
                >
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M1.5 4L6 8.5L10.5 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
                  </svg>
                </button>
                <ul class="header__submenu">
                  {item.children.map((child) => (
                    <li>
                      <a
                        class="header__submenu-link"
                        href={child.href}
                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                      >{child.label}</a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__cta-col">
      <a
        class="btn btn--primary btn--cta header__cta"
        href={headerCta.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="btn__icon" width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 1v8.5m0 0L4.5 6M8 9.5L11.5 6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 11.5v1A1.5 1.5 0 003.5 14h9a1.5 1.5 0 001.5-1.5v-1" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
        </svg>
        {headerCta.label}
      </a>
    </div>
  </Container>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const nav = document.querySelector<HTMLElement>('#primary-menu');

  const setOpen = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    burger?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('has-menu-open', open);
    if (open) close?.focus();
    else burger?.focus();
  };

  burger?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) setOpen(false);
  });

  // Submenus: hover opens them above 599px, click is the touch/keyboard path.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]')) {
    toggle.addEventListener('click', () => {
      const li = toggle.closest('.header__item');
      const open = li?.classList.toggle('is-open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
