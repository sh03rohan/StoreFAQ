---

import Words from '../Words.astro';import { Image } from 'astro:assets';
import LearnMore from '../LearnMore.astro';
import swoosh from '../../assets/home/Group-39473.png';
import media from '../../assets/home/Component-1.png';
---
<div class="flead">
  <div class="flead__text">
    <div class="flead__swoosh" data-anim="chip">
      <Image src={swoosh} alt="" width={58} height={54} loading="lazy" />
    </div>
    <div class="flead__head">
      <Words class="flead__title" html={'Write <span class="flead__mark">Frequently Answered Questions</span> With The Magic Of AI'} />
      <p class="flead__sub" data-anim="text">Answer your common customer questions&nbsp; faster than ever with the help of AI.</p>
    </div>
    <div data-anim="chip"><LearnMore slug="generate-faqs-using-ai-autowrite" /></div>
  </div>
  <div class="flead__media" data-anim="media">
    <Image src={media} alt="StoreFAQ writing an answer with AI" widths={[675, 1240]} sizes="(min-width: 1280px) 60vw, 100vw" loading="lazy" />
  </div>
</div>
