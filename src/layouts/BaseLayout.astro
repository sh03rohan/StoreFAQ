---
import '../styles/tokens.css';
import Motion from '../components/Motion.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = '',
  canonical,
  ogImage,
  robots = 'index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large',
  type = 'website',
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="alternate" type="application/rss+xml" title="StoreFAQ" href="/feed/" />

    <!-- Hide the animated blocks before first paint, but only when motion is
         welcome. Anyone on `prefers-reduced-motion: reduce` never gets the
         class, so nothing is ever hidden pending JavaScript. The timeout is
         the failsafe for the module failing to load; it cancels itself once
         the module takes over. -->
    <script is:inline>
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('js-anim');
        window.__animFailsafe = setTimeout(function () {
          // The module has not arrived. Reveal everything and leave a flag, so
          // that if it turns up late it does NOT hide the content again to
          // animate it — that would read as content vanishing.
          document.documentElement.classList.remove('js-anim');
          window.__animGaveUp = true;
        }, 2500);
      }
    </script>

    <!-- Preload only the two families used above the fold. -->
    <link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-page text-ink font-body text-base antialiased">
    <slot />
    <Motion />
  </body>
</html>
