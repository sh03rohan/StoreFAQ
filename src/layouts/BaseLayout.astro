---
import '../styles/tokens.css';
import Motion from '../components/Motion.astro';
import Effects from '../components/Effects.astro';
import { seoFor } from '../data/seo';

/**
 * Pages pass `route` and the title, description, social image and schema come
 * from src/data/seo.ts — extracted from the live pages, because those are the
 * strings that rank. `title`/`description` remain overridable for routes that
 * are generated rather than listed (blog posts, docs articles).
 */
export interface Props {
  route?: string;
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD nodes for a page that needs more than its own WebPage. */
  schema?: Record<string, unknown>[];
  /** Open Graph article facts, for blog posts. */
  article?: { published: string; modified: string; author: string; section?: string };
  /** Feeds a generated page advertises (listed pages take theirs from seo.ts). */
  feeds?: { title: string; href: string }[];
}

const {
  route,
  canonical,
  robots = 'index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large',
  type = 'website',
  schema: extraSchema = [],
  article,
} = Astro.props;

const seo = route ? seoFor(route) : undefined;
if (route && !seo) throw new Error(`No SEO entry for route "${route}" — add it to src/data/seo.ts`);

const feeds = Astro.props.feeds ?? seo?.feeds ?? [];
const title = Astro.props.title ?? seo?.title ?? '';
const description = Astro.props.description ?? seo?.description ?? '';

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

/* Mirrored into /media/ rather than hotlinked from the WordPress uploads
 * directory, which §B1 keeps out of the output entirely. */
const social = Astro.props.ogImage ?? seo?.ogImage ?? undefined;
const ogImage = social ? new URL(social, Astro.site).href : undefined;

/* The original carries WebSite and Organization on the home page only, and a
 * WebPage (or CollectionPage) on each page. Reproduced, minus the WebSite's
 * `potentialAction` — it advertises `/?s={term}`, a WordPress search endpoint
 * this build does not have, and pointing crawlers at a 404 is worse than
 * saying nothing. */
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const isHome = Astro.url.pathname === '/';
const jsonLd = [
  ...(isHome ? [
    { '@context': 'https://schema.org', '@type': 'WebSite',
      '@id': `${site}/#website`, name: 'storefaq.io', url: `${site}/` },
    { '@context': 'https://schema.org', '@type': 'Organization',
      '@id': `${site}#organization`, name: 'storefaq.io', url: site },
  ] : []),
  ...(seo?.schema ? [{
    '@context': 'https://schema.org',
    '@type': seo.schema.type,
    name: seo.schema.name,
    url: canonicalUrl,
    ...(seo.schema.datePublished ? { datePublished: seo.schema.datePublished } : {}),
    ...(seo.schema.dateModified ? { dateModified: seo.schema.dateModified } : {}),
    ...(seo.schema.image ? { image: new URL(seo.schema.image, Astro.site).href } : {}),
    ...(seo.schema.type === 'CollectionPage'
      ? { isPartOf: { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/` },
          description }
      : {}),
  }] : []),
  ...extraSchema,
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/* The original's own keywords, where the page has them. Search engines
        have ignored this tag for years — it is here because it is the client's
        authored content, and dropping authored content silently is exactly the
        mistake the titles above were. */}
    {seo?.keywords && <meta name="keywords" content={seo.keywords} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="storefaq.io" />
    <meta property="og:locale" content="en_US" />
    {article && (
      <>
        <meta property="article:published_time" content={article.published} />
        <meta property="article:modified_time" content={article.modified} />
        <meta property="article:author" content={article.author} />
        {article.section && <meta property="article:section" content={article.section} />}
      </>
    )}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImage && seo?.ogImageSize && (
      <>
        <meta property="og:image:width" content={String(seo.ogImageSize.width)} />
        <meta property="og:image:height" content={String(seo.ogImageSize.height)} />
        <meta property="og:image:type" content={seo.ogImageSize.type} />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && seo?.ogImageAlt && (
      <>
        <meta property="og:image:alt" content={seo.ogImageAlt} />
        <meta name="twitter:image:alt" content={seo.ogImageAlt} />
      </>
    )}

    {jsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    {/* Per-route, and a page can advertise more than one: /docs/ carries the
        site feed AND its own. */}
    {feeds.map((f) => (
      <link rel="alternate" type="application/rss+xml" title={f.title} href={f.href} />
    ))}

    <!-- Hide the animated blocks before first paint, but only when motion is
         welcome. Anyone on `prefers-reduced-motion: reduce` never gets the
         class, so nothing is ever hidden pending JavaScript. The timeout is
         the failsafe for the module failing to load; it cancels itself once
         the module takes over. -->
    <script is:inline>
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('js-anim', 'fx');
        window.__animFailsafe = setTimeout(function () {
          // The module has not arrived. Reveal everything and leave a flag, so
          // that if it turns up late it does NOT hide the content again to
          // animate it — that would read as content vanishing.
          document.documentElement.classList.remove('js-anim');
          window.__animGaveUp = true;
        }, 2500);
      }
    </script>

    <!-- Preload only the two families used above the fold. -->
    <link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-page text-ink font-body text-base antialiased">
    <slot />
    <Motion />
    <Effects />
  </body>
</html>
