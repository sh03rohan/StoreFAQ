---

import Words from '../components/Words.astro';/**
 * The theme's 404: a Cardo "Page Not Found", the theme's own sentence, and a
 * search form. The form searched WordPress; here it searches the blog, which
 * is where an unknown path on this site most likely wanted to go. Served
 * with HTTP 404 — Vercel uses this page for any path nothing else answers,
 * and the on-demand routes return it for an unknown post or category.
 * Measured from https://storefaq.io/this-does-not-exist/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes } from '../lib/routes';
---
<BaseLayout title="Page not found – storefaq.io" description="The page you are looking for does not exist, or it has been moved." robots="noindex, follow">
  <Header />
  <main class="nf">
    <Words as="h1" class="nf__title" html="Page Not Found" now />
    <p class="nf__text">The page you are looking for does not exist, or it has been moved. Please try searching using the form below.</p>
    <form class="nf__form" role="search" action={routes.blog()} method="get">
      <label class="sr-only" for="nf-q">Search</label>
      <input class="nf__input" id="nf-q" type="search" name="s" placeholder="" />
      <button class="nf__submit" type="submit">Search</button>
    </form>
  </main>
  <Footer />
</BaseLayout>
