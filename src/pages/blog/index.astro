---
/**
 * /blog/ — rendered on demand from the CMS (guide §A3) so a new post shows
 * without a rebuild; Vercel ISR holds the result and WordPress purges it on
 * publish (§B6).
 */
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogListing from '../../components/blog/BlogListing.astro';
import { loadListing } from '../../lib/blog-page';
import { routes } from '../../lib/routes';

/* A search lands on its own, uncached route — see blog/search.astro. */
if (Astro.url.searchParams.get('s')) return Astro.redirect(`${routes.blogSearch()}?s=${encodeURIComponent(Astro.url.searchParams.get('s')!)}`, 302);
const listing = await loadListing(Astro, {});
if (listing instanceof Response) return listing;
---
<BaseLayout
  route="/blog/"
  title={listing.title}
  canonical={listing.canonical}
  robots={listing.robots}
>
  <Header />
  <main>
    <BlogListing page={listing.page} categories={listing.categories} pageUrl={listing.pageUrl} />
  </main>
  <Footer />
</BaseLayout>
