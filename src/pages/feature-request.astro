---

import Words from '../components/Words.astro';import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import FormField from '../components/FormField.astro';
---
<BaseLayout route="/feature-request/">
  <Header />
  <main class="plain">
    <Words as="h1" class="plain__title" html="Feature Request" now delay={0.05} />
    <div class="plain__body">
      <section class="frq">
        <Container width="content" class="frq__row">
          <div class="frq__col">
            <Words class="frq__title" html="Feature Requests" />
            <p class="frq__intro" data-anim="text">
              Cannot find your favorite feature in StoreFAQ? We are all ears! Let us know your
              ideas or suggestions; we are always trying to improve StoreFAQ and would love to
              know what new features you want us to bring next!
            </p>
          </div>

          <div class="frq__col">
            <!-- Posts to /api/feature-request/, which forwards to the CMS. That
                 endpoint returns a clear "temporarily unavailable" until the
                 headless WordPress wiring lands (Phase 6) — the same posture as
                 the newsletter form and the docs search. -->
            <div class="frq__form-wrapper" data-anim="media">
            <form class="frq__form" method="post" action="/api/feature-request/">
              <div class="frq__fields">
                <FormField id="fr-name"    name="name"    label="Name"    icon="user"     placeholder="Enter your name here..." required />
                <FormField id="fr-email"   name="email"   label="Email"   icon="envelope" type="email" placeholder="Enter your email here..." required faint />
                <FormField id="fr-subject" name="subject" label="Subject" icon="pencil"   placeholder="Enter your subject here..." required />
                <FormField id="fr-message" name="message" label="Message" icon="edit"     placeholder="Enter your message here..." textarea rows={4} />
              </div>
              <div class="frq__submit-wrap">
                <button type="submit" class="frq__submit">Submit</button>
              </div>
            </form>
            <p class="frq__status" role="status" aria-live="polite"></p>
            </div>
          </div>
        </Container>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  /* Progressive enhancement: the form is a real POST to the API route, so it
   * works without this. With JavaScript, submit in place and report the result
   * rather than navigating away. */
  const form = document.querySelector<HTMLFormElement>('.frq__form');
  const status = document.querySelector<HTMLParagraphElement>('.frq__status');

  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('.frq__submit');
      const say = (text: string, state: 'ok' | 'error') => {
        status.textContent = text;
        status.dataset.state = state;
      };

      if (button) { button.disabled = true; button.textContent = 'Sending'; }
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const body = await res.json().catch(() => ({ message: 'Something went wrong.' }));
        say(body.message, res.ok ? 'ok' : 'error');
        if (res.ok) form.reset();
      } catch {
        say('Something went wrong. Please try again.', 'error');
      } finally {
        if (button) { button.disabled = false; button.textContent = 'Submit'; }
      }
    });
  }
</script>
