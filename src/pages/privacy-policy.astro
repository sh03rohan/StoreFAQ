---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { privacyHtml } from '../data/privacy';
---
<BaseLayout route="/privacy-policy/">
  <Header />
  <main class="plain">
    <h1 class="plain__title" data-anim="heading" data-anim-intro style="--anim-d:.05s;--anim-y:24px">Privacy Policy</h1>
    <!-- Generated from the captured page by scripts/extract-privacy.mjs — a
         legal document reproduced word for word, with every WordPress class
         and wrapper dropped at extraction time (§B1). -->
    <div class="plain__body" set:html={privacyHtml} />
  </main>
  <Footer />
</BaseLayout>
