# WordPress CMS (headless). No trailing slash.
WP_URL=https://cms.storefaq.io

# FluentCRM — newsletter subscribe endpoint (guide §B5, decision A1)
FLUENTCRM_URL=https://cms.storefaq.io/wp-json/fluent-crm/v2
FLUENTCRM_USER=
FLUENTCRM_APP_PASSWORD=
FLUENTCRM_LIST_ID=
FLUENTCRM_TAG_ID=

# Vercel ISR bypass token — lets WP purge a post on publish (guide §B6)
VERCEL_BYPASS_TOKEN=

# Analytics
PUBLIC_GA4_ID=
